# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser authentication
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Server-side PostgreSQL connection (use the deployment provider's real value)
POSTGRES_URL=[replace-with-pooled-postgres-url]
POSTGRES_URL_NON_POOLING=

# Comma-separated administrator emails
ADMIN_EMAILS=admin@example.com

# Server-only Supabase Auth administration (never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts administrator-stored AI provider keys (32+ random characters)
AI_SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Administrator-managed AI provider secrets
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
CUSTOM_AI_API_KEY=

# PortOne V2 + NHN KCP
PORTONE_STORE_ID=store-example
PORTONE_CHANNEL_KEY=channel-key-example
PORTONE_API_SECRET=replace-with-portone-api-secret
PORTONE_WEBHOOK_SECRET=whsec_replace-with-standard-webhook-secret
