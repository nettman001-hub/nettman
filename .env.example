# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side PostgreSQL connection (use the deployment provider's real value)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Comma-separated administrator emails
ADMIN_EMAILS=

# Server-only Supabase Auth administration (never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts administrator-stored AI provider keys (32+ random characters)
AI_SETTINGS_ENCRYPTION_KEY=

# Optional dedicated HMAC secret for scripture normalization grants (32+ characters)
SCRIPTURE_NORMALIZATION_SECRET=

# Administrator-managed AI provider secrets
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
CUSTOM_AI_API_KEY=

# PortOne V2 + NHN KCP
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# Local-only fallback; never enable these in production
SERMON_LOCAL_MODE=false
SERMON_LOCAL_ADMIN=false

# Legacy Stripe compatibility only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
